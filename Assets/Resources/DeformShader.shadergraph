    "m_SourceType": 1,
    "m_FunctionName": "Grass",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "//Vector2 indeksNaSiatce = new Vector2((int)((position.x - centerTerrain.x + side / 2f * spacing) / sizeW + 0.5f), (int)((position.z - centerTerrain.y + side / 2f * spacing) / sizeH + 0.5f));\r\nfloat wyr =  _Side / 2 * _Spacing;\nfloat2 index = floor(float2((PositionWorld.x - _CenterTerrain.x + wyr) / _SizeWSizeH.x + 0.5, (PositionWorld.z - _CenterTerrain.y + wyr) / _SizeWSizeH.y + 0.5));\n//int2 cell = clamp((int2)index, 0, int2(8, 8) - 1);\nfloat2 wind = _WindTexture.Load(int3(index.x, index.y, 0)).rg;\nWindOut = float3(index.x, index.y, 1.0);\n\nfloat y2 = Position.y * Position.y;\nfloat3 position = float3(Position.x, Position.y - k1 * y2, Position.z + k2 * y2);\n\nfloat3 dir = float3(wind.x, 1.0, 1.0);\nfloat y2b = position.y * position.y;\r\nfloat3 T = _ExternalForce * float3(dir.x * y2b, -length(dir) * y2b, -dir.y * y2b);\n//T = mul((float3x3)unity_WorldToObject, T);\nT = TransformWorldToObjectDir(T, false);\n//float3x3 m = (float3x3)GetObjectToWorldMatrix();\n//T = mul(T, m);\n\r\nPositionOut = position + (1 - lambda) * T;\r\n"
}

