{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "a886d6f47adc4bfe99326786f2130736",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Grass (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -456.0,
            "y": 0.00001137881918111816,
            "width": 206.6666717529297,
            "height": 126.66667175292969
        }
    },
    "m_Slots": [
        {
            "m_Id": "eb0e713f8ca24ee29c8cdc59e2dea15e"
        },
        {
            "m_Id": "8acbf7aea3b44036b9fd79ac19cdfc5b"
        },
        {
            "m_Id": "cb09614923b74a8181f80abb3c0da52a"
        },
        {
            "m_Id": "f29cdede1b6546bf8542ffa5eab4f791"
        },
        {
            "m_Id": "49d525ecabab44ec9d027b252f120d59"
        },
        {
            "m_Id": "cd1398828dd44d2a8990b69e7b1e6ba7"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Grass",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "\r\nfloat y2 = Position.y * Position.y;\nfloat3 position = float3(Position.x, Position.y - k1 * y2, Position.z + k2 * y2);\n\nfloat3 dir = float3(1.0, 1.0, 1.0);\nfloat y2b = position.y * position.y;\r\nfloat3 T = externalForce * float3(dir.x * y2b, -length(dir) * y2b, -dir.y * y2b);\n\r\nPositionOut = position + (1 - lambda) * T;\r\n"
}

