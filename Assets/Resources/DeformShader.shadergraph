{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "a886d6f47adc4bfe99326786f2130736",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Grass (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -484.6666564941406,
            "y": -88.00000762939453,
            "width": 209.33331298828126,
            "height": 352.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "eb0e713f8ca24ee29c8cdc59e2dea15e"
        },
        {
            "m_Id": "8acbf7aea3b44036b9fd79ac19cdfc5b"
        },
        {
            "m_Id": "cb09614923b74a8181f80abb3c0da52a"
        },
        {
            "m_Id": "f29cdede1b6546bf8542ffa5eab4f791"
        },
        {
            "m_Id": "cd1398828dd44d2a8990b69e7b1e6ba7"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Grass",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "//Vector2 indeksNaSiatce = new Vector2((int)((position.x - centerTerrain.x + side / 2f * spacing) / sizeW + 0.5f), (int)((position.z - centerTerrain.y + side / 2f * spacing) / sizeH + 0.5f));\r\nfloat3 pivotObject = TransformObjectToWorld(float3(0,0,0));\n\nfloat wyr =  _Side / 2 * _Spacing;\nfloat2 index = floor(float2((pivotObject.x - _CenterTerrain.x + wyr) / _SizeWSizeH.x + 0.5, (pivotObject.z - _CenterTerrain.y + wyr) / _SizeWSizeH.y + 0.5));\nint2 cell = clamp((int2)index, 0, int2(_GridResolution, _GridResolution) - 1);\nfloat2 wind = _WindTexture.Load(int3(cell.x, cell.y, 0)).rg;\n\nfloat y2 = Position.y * Position.y;\nfloat3 position = float3(Position.x, Position.y - k1 * y2, Position.z + k2 * y2);\n\nfloat y2b = position.y * position.y;\r\nfloat3 T = _ExternalForce * float3(wind.x * y2b, -length(wind) * y2b, wind.y * y2b); // W OpenGL -wind.y\nT = TransformWorldToObjectDir(T, false);\n\n//T = mul((float3x3)unity_WorldToObject, T);\n//float3x3 m = (float3x3)GetObjectToWorldMatrix();\n//T = mul(T, m);\n\r\nPositionOut = position + (1 - lambda) * T;\n\n\r\n"
}

